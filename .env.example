NODE_ENV=production
PORT=3000

# Database — Railway PostgreSQL
# (Railway auto-sets DATABASE_URL, але ми читаємо окремі змінні)
DB_HOST=your-railway-postgres-host.railway.internal
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Strong_New_Password_123!
DB_DATABASE=railway

# Redis — Railway Redis
REDIS_HOST=your-railway-redis-host.railway.internal
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-super-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-another-secret-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Frontend URL (Vercel)
FRONTEND_URL=https://your-app.vercel.app

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Email SMTP (наприклад, Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
