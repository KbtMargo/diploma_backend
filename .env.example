NODE_ENV=production
PORT=3000

# Database — Railway PostgreSQL
# В Railway dashboard встанови через Variable References:
# DB_HOST = ${{Postgres.PGHOST}}
# DB_PORT = ${{Postgres.PGPORT}}
# DB_USERNAME = ${{Postgres.PGUSER}}
# DB_PASSWORD = ${{Postgres.PGPASSWORD}}
# DB_DATABASE = ${{Postgres.PGDATABASE}}
DB_HOST=
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=railway

# Перший деплой: DB_SYNC=true щоб створились таблиці.
# Після першого успішного запуску — змінити на false.
DB_SYNC=true

# Redis — Railway Redis
# В Railway dashboard: REDIS_URL = ${{Redis.REDIS_URL}}
REDIS_URL=

# JWT
JWT_SECRET=change-me-super-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-another-secret-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Frontend URL (Vercel) — твій реальний домен
FRONTEND_URL=https://your-app.vercel.app

# Google Gemini AI
GEMINI_API_KEY=

# Email SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
